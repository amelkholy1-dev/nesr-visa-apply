{
  "manifest_version": 3,
  "name": "نسر الخليج — تعبئة طلب التأشيرة",
  "description": "بيملا فورم «طلب تأشيرة» في منصة التأشيرات وفورم حجز الفحص الطبي في وافد من نظام طلبات التأشيرات. الكابتشا والإقرارات (إلا اللي فعّلته بنفسك) والحفظ بتتم بإيدك.",
  "version": "1.4.1",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://visa.mofa.gov.sa/*",
    "https://*.nisrelkhaleeg.com/*",
    "https://wafid.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://visa.mofa.gov.sa/*"
      ],
      "js": [
        "content-mofa.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wafid.com/*"
      ],
      "js": [
        "content-wafid.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.nisrelkhaleeg.com/*"
      ],
      "js": [
        "content-app.js"
      ],
      "run_at": "document_start"
    }
  ]
}