# ===== إعدادات نظام طلبات التأشيرات (انسخها في Environment variables على Hostinger) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# مكان الصور (برّه فولدر البرنامج عشان التحديثات ما تمسحهاش)
VISA_DATA_DIR=~/visa-apply-data
# سر توقيع الجلسات (نص عشوائي طويل)
AUTH_SECRET=
# أول مدير (بيتعمل مرة واحدة لما مفيش مستخدمين)
ADMIN_USER=admin
ADMIN_PASSWORD=
# اختياري: قراءة الجواز من الصورة بـ Gemini (من غيره بتلصق سطري MRZ بإيدك)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TZ=Africa/Cairo
